# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com valores reais

# Supabase
VITE_SUPABASE_PROJECT_ID="seu_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_anon_key"
VITE_SUPABASE_URL="https://seu_project_id.supabase.co"

# Senha do Super Admin (use uma senha forte)
VITE_ADMIN_PASSWORD="sua_senha_forte_aqui"

# Emails autorizados no Super Admin (separados por vírgula)
VITE_ADMIN_EMAILS="admin@seudominio.com,outro@seudominio.com"
